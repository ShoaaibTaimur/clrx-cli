# ============================================================
# ClrX — .npmignore
# Files/dirs listed here are excluded from the published package.
# The "files" field in package.json already whitelists dist/,
# README.md, and LICENSE — this file adds an extra safety net.
# ============================================================

# ── Source (TypeScript) ──────────────────────────────────────
src/

# ── Tests ────────────────────────────────────────────────────
tests/
*.test.ts
*.spec.ts
vitest.config.ts
coverage/

# ── TypeScript build artifacts ───────────────────────────────
tsconfig.json
*.tsbuildinfo

# ── Compiled declaration files (not needed for a CLI) ────────
dist/**/*.d.ts
dist/**/*.d.ts.map

# ── Source maps (optional — remove this block if you want them) ─
dist/**/*.js.map

# ── Internal test helper (not part of public API) ────────────
dist/core/registry-test-helper.js

# ── Dev tooling config ───────────────────────────────────────
eslint.config.js
prettier.config.js
.eslintrc*
.prettierrc*

# ── Git ──────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── CI / GitHub ──────────────────────────────────────────────
.github/
.circleci/
.travis.yml

# ── Environment & secrets ────────────────────────────────────
.env
.env.*
!.env.example

# ── macOS ────────────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ── Editor & IDE ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Node / npm ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# ── Misc ─────────────────────────────────────────────────────
*.log
.cache/
tmp/
temp/
