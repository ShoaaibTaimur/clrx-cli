{
  "name": "@shoaaib_taimur/clrx",
  "version": "1.0.5",
  "description": "Safe, modern macOS storage cleaner CLI",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "clrx": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShoaaibTaimur/clrx-cli.git"
  },
  "bugs": {
    "url": "https://github.com/ShoaaibTaimur/clrx-cli/issues"
  },
  "homepage": "https://github.com/ShoaaibTaimur/clrx-cli#readme",
  "files": [
    "dist/**/*.js",
    "!dist/core/registry-test-helper.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "postbuild": "chmod +x dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test && npm run lint"
  },
  "keywords": [
    "macos",
    "cleaner",
    "storage",
    "cache",
    "cli",
    "disk-cleanup"
  ],
  "author": "Shoaaib Taimur",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "darwin"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.5.2",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "eslint": "^9.27.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.3"
  }
}